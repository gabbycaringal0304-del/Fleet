rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['id', 'uid', 'authUid', 'role'])
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'authUid', 'role', 'email', 'username', 'name',
          'co', 'phone', 'license', 'exp', 'car', 'on', 'createdAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.uid == uid
        && request.resource.data.authUid == uid
        && request.resource.data.role == 'driver'
      );
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}